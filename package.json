{
  "name": "nabiz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "browser:install": "node scripts/install-browser.mjs",
    "e2e": "tsx scripts/e2e-web.mts",
    "dev": "concurrently -k -n api,web \"npm run dev -w @nabiz/api\" \"npm run dev -w @nabiz/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck -w @nabiz/api",
    "prisma:generate": "npm run prisma:generate -w @nabiz/api",
    "prisma:validate": "npm run prisma:validate -w @nabiz/api",
    "db:push": "npm run db:push -w @nabiz/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w @nabiz/api",
    "db:deploy": "npm run db:deploy -w @nabiz/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.2"
  }
}
