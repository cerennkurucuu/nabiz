generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Bootstrap model only. Domain models belong to subsequent issues.
model AppMetadata {
  key   String @id
  value String
}

model User {
  id        String    @id @default(cuid())
  googleSub String    @unique
  email     String
  name      String
  createdAt DateTime  @default(now())
  sessions  Session[]
  scans     ScanJob[]
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAttempt {
  stateHash String   @id
  nonce     String
  verifier  String
  expiresAt DateTime

  @@index([expiresAt])
}

model ScanJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  urls      String
  status    String   @default("queued")
  progress  Int      @default(0)
  error     String?
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artifacts ScanArtifact[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Ekran görüntüleri JSON içine gömülmez; dosya deposunda saklanır ve burada
// yalnızca üst veri tutulur. Erişim tarama sahibine bağlıdır.
model ScanArtifact {
  id        String   @id
  scanId    String
  scan      ScanJob  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  userId    String
  kind      String
  viewport  String
  url       String
  selector  String?
  label     String?
  fileName  String
  bytes     Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([userId, createdAt])
}
