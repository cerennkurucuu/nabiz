NODE_ENV=development
HOST=127.0.0.1
PORT=3100
# Relative to apps/api/prisma/schema.prisma
DATABASE_URL=file:./nabiz.db
# Public frontend origin; use one hostname consistently in browser and Google Console.
APP_ORIGIN=http://127.0.0.1:4300
# Google OAuth web client: keep both blank to disable login until configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered as an exact authorized redirect URI in Google Console.
GOOGLE_REDIRECT_URI=http://127.0.0.1:4300/api/auth/google/callback
