NODE_ENV=development
HOST=127.0.0.1
PORT=3100
# Relative to apps/api/prisma/schema.prisma
DATABASE_URL=file:./nabiz.db
# Register this exact frontend origin as an Authorized JavaScript origin in Google Console.
# Canonical development address. The browser must use exactly this address: the API
# rejects write requests whose Origin header does not match, and the Google button
# is only rendered for registered origins. http://127.0.0.1:4300 is a different
# origin for both Google and the API.
APP_ORIGIN=http://localhost:4300
# Google Identity Services: only a Web client ID is required, no client secret.
# Leave blank to show the unconfigured state. Never put ID tokens in this file.
GOOGLE_CLIENT_ID=
# Public URL scanning stays closed until the deployment egress isolation is verified.
# Set to true only for local development with the URL policy enabled.
SCANNING_ENABLED=false
# PageSpeed Insights API. The key is optional: without it the anonymous quota is
# used, which is often exhausted. The request is made server side, so the key
# must NOT be restricted to HTTP referrers ("Websites"); use "APIs" or "None".
PAGESPEED_ENABLED=true
PAGESPEED_API_KEY=
